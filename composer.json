{
	"name": "codeigniter4/appstarter",
	"type": "project",
	"description": "Template Aplikasi PHP Framework CI 4",
	"homepage": "https://codeigniter.com",
	"license": "MIT",
	"require": {
		"php": "^7.3||^8.0",
		"codeigniter4/framework": "4.3.4",
		"benedmunds/codeigniter-ion-auth": "4.x-dev",
		"firebase/php-jwt": "dev-main",
		"endroid/qr-code": "6.x-dev",
		"khanamiryan/qrcode-detector-decoder": "dev-master"
	},
	"suggest": {
		"ext-fileinfo": "Improves mime type detection for files"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app",
			"Config\\": "app/Config"
		},
		"exclude-from-classmap": [
			"**/Database/Migrations/**"
		]
	},
	"support": {
		"forum": "http://forum.codeigniter.com/",
		"source": "https://github.com/codeigniter4/CodeIgniter4",
		"slack": "https://codeigniterchat.slack.com"
	},
	"minimum-stability": "dev",
	"repositories": {
		"ionAuth": {
			"type": "vcs",
			"url": "git@github.com:sudadi/CodeIgniter-Ion-Auth.git"
		}
	}
}
